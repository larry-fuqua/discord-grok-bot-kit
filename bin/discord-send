#!/usr/bin/env python3
"""Send a message to the configured Discord channel as the bot."""
import json
import os
import sys
import urllib.request
from pathlib import Path


def load_env(path: Path) -> dict:
    out = {}
    if not path.exists():
        return out
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def find_cfg() -> Path:
    env_dir = os.environ.get("DISCORD_RELAY_DIR")
    if env_dir:
        return Path(env_dir) / "config.env"
    here = Path(__file__).resolve().parent
    for candidate in (here.parent / "config.env", Path("config.env")):
        if candidate.exists():
            return candidate
    return here.parent / "config.env"


if len(sys.argv) < 2:
    sys.stderr.write("usage: discord-send <text>\n")
    sys.exit(2)
text = " ".join(sys.argv[1:]).strip()
if not text:
    sys.exit(2)
cfg_path = find_cfg()
if not cfg_path.exists():
    sys.stderr.write(f"missing {cfg_path}\n")
    sys.exit(1)
env = load_env(cfg_path)
token = env.get("DISCORD_BOT_TOKEN") or os.environ.get("DISCORD_BOT_TOKEN") or ""
channel = env.get("DISCORD_CHANNEL_ID") or os.environ.get("DISCORD_CHANNEL_ID") or ""
if not token or not channel:
    sys.stderr.write("bot token or channel id missing\n")
    sys.exit(1)
data = json.dumps({"content": text[:1900]}).encode()
req = urllib.request.Request(
    f"https://discord.com/api/v10/channels/{channel}/messages",
    data=data,
    headers={
        "Authorization": f"Bot {token}",
        "Content-Type": "application/json",
        "User-Agent": "GrokBotDiscordRelay/1.0",
    },
    method="POST",
)
with urllib.request.urlopen(req, timeout=30) as resp:
    print(resp.status, flush=True)
